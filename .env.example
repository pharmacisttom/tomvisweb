# ==============================================================================
# TOMVIS Framework - Environment Variables Example Template
# WARNING: Do NOT commit production secrets, keys, or passwords to git.
# Duplicate this file as .env.local for local development or .env on VPS.
# ==============================================================================

# Application Environment Mode
NODE_ENV=production

# Server Listen Port (Default PM2 cluster: 3000)
PORT=3000

# Canonical Public Domain URL (Used for Sitemap & OpenGraph absolute URLs)
NEXT_PUBLIC_BASE_URL=https://tomvisolution.tech

# Optional Analytics or Operational Telemetry Key Placeholder
# NEXT_PUBLIC_ANALYTICS_ID=

# SMTP / Transactional Mail Relay Config Placeholder (Server-side only)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
